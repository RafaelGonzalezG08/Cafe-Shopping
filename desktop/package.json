{
  "name": "cafe-shopping-desktop",
  "version": "1.0.8",
  "description": "Cafe Shopping - punto de venta de escritorio (sin Docker: base local y agente de WhatsApp integrados)",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.cafeshopping.desktop",
    "productName": "Cafe Shopping",
    "asar": true,
    "files": [
      "main.js",
      "nativo.js",
      "preload.js",
      "splash.html",
      "build/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../backend",
        "to": "app-project/backend",
        "filter": [
          "dist/**/*",
          "prisma/migrations/**/*",
          "prisma/schema.prisma",
          "package.json",
          "node_modules/**/*",
          "!node_modules/.cache/**",
          "!node_modules/**/*.md",
          "!node_modules/**/test/**",
          "!node_modules/**/tests/**",
          "!node_modules/@types/**",
          "!node_modules/typescript/**",
          "!node_modules/@nestjs/cli/**",
          "!node_modules/@nestjs/schematics/**",
          "!node_modules/jest/**",
          "!node_modules/ts-jest/**",
          "!node_modules/eslint/**",
          "!node_modules/prettier/**",
          "!node_modules/prisma/**",
          "!prisma/cliente-postgres/**",
          "!prisma/*.db"
        ]
      },
      {
        "from": "../frontend/dist",
        "to": "app-project/frontend/dist"
      },
      {
        "from": "..",
        "to": "app-project",
        "filter": [
          "send_whatsapp_agent.exe",
          "send_whatsapp_agent.ahk"
        ]
      }
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Cafe Shopping"
    },
    "publish": {
      "provider": "github",
      "owner": "RafaelGonzalezG08",
      "repo": "cafe-shopping"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "allowScripts": {
    "electron@31.7.7": true
  }
}
