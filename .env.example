# Variables leidas por docker-compose.yml (no por el backend directamente).
# Copia este archivo a ".env" en la raiz del proyecto y ajusta los valores.

# ---------- URL publica de la factura (para el link de WhatsApp) ----------
# Se llena con la URL que imprime el servicio "tunnel" al arrancar (ver
# README > "Hacer publica la factura sin crear cuentas"). Ejemplo:
# BACKEND_PUBLIC_URL=https://palabras-al-azar.trycloudflare.com
BACKEND_PUBLIC_URL=

# ---------- Respaldos automaticos ----------
# Carpeta del HOST (tu PC) donde se guardan los respaldos cada 3 dias. Si
# esta carpeta esta dentro de tu OneDrive, se sincroniza a la nube sola.
#
# Los archivos .env NO permiten variables como %USERPROFILE% (Docker Compose
# las trata como texto literal, no las expande), asi que si quieres que esto
# funcione en cualquier PC/usuario sin editarlo a mano, deja el valor por
# defecto (./backups) y en vez de escribir la ruta aqui, define la variable
# justo antes de levantar Docker, por ejemplo en PowerShell:
#   $env:BACKUP_HOST_DIR = "$env:USERPROFILE\OneDrive\Respaldos-CafeShopping"
#   docker compose up -d
# Esa variable de entorno del sistema tiene prioridad sobre este archivo.
BACKUP_HOST_DIR=./backups
BACKUP_INTERVAL_DAYS=3
BACKUP_RETENTION_DAYS=30
