# Dependencias y compilaciones
node_modules/
dist/
build/

# Variables de entorno y credenciales
.env
*.env

# Archivos pesados y respaldos
/backups/
*.sql
*.sql.gz

# ...pero las migraciones de Prisma SI van al repo. La regla "*.sql" de arriba
# es para los volcados de respaldo (pg_dump), y sin esta excepcion se tragaba
# tambien las migraciones: al clonar o hacer pull en otra PC llegaba el codigo
# nuevo pero no el SQL que crea las tablas que ese codigo necesita.
!backend/prisma/migrations/**/*.sql
/uploads/

# Archivos de registros y temporales
*.log
desktop/dist/
# Base de datos local de la version nativa (SQLite) y su copia de restauracion
backend/prisma/*.db
backend/prisma/*.db-journal
backend/prisma/*.db.anterior

# JS compilado que se cuela en src/ al compilar el seed
backend/src/**/*.js

# Cliente de Prisma generado solo para leer Postgres durante la migracion
backend/prisma/cliente-postgres/
